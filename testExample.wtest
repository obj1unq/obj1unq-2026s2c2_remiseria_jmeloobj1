import remiseria.*

describe "group of tests for remises" {

test "torino"{
   const torinoNegro = new Torino()
  torinoNegro.color("negro")
  assert.that(torinoNegro.color() == "negro")
}

test "economico" {
  const economicoAD = new Economico()
  assert.equals(economicoAD.adaptaciones(), {0})
}

}